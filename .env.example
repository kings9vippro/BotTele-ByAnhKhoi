# Web authentication (required in production)
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
ADMIN_PRINCIPAL_ID=web-admin
REQUIRE_WEB_CSRF=1

# Persistent storage
APP_DATA_DIR=/var/data
DATABASE_PATH=/var/data/database.db

# Web-only deployment
DISABLE_TELEGRAM_BOT=1

# Official OAuth; create these values in the provider developer consoles.
OAUTH_PUBLIC_BASE_URL=https://your-domain.example
OAUTH_ENCRYPTION_KEY=replace-with-a-fernet-key
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Runtime tuning
GUNICORN_THREADS=16
TRUSTED_PROXY_HOPS=1
